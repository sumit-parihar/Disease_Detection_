# ---------------------------------------------------------------
# .gitignore  -  files Git must NOT upload
# ---------------------------------------------------------------

# 1. Raw datasets (large, and re-downloadable with download_plantvillage.py
#    and the Kaggle download). Never commit raw images.
data/

# 2. Python virtual environment (rebuilt on the other PC from requirements.txt)
venv/
.venv/
env/

# 3. Python cache files
__pycache__/
*.py[cod]
*.egg-info/

# 4. Secrets. NEVER upload your Kaggle token.
kaggle.json
.kaggle/
.env

# 5. Trained model weights (large; regenerated by training)
models/
*.pt
*.pth
*.ckpt
*.onnx

# 6. Notebook checkpoints and editor files
.ipynb_checkpoints/
.vscode/
.idea/

# 7. Operating system files
Thumbs.db
desktop.ini
.DS_Store

# 8. Temporary and large result files (keep small CSV/JSON result tables)
*.log
*.tmp
*.zip
*.tar
*.npy
*.npz

# ---------------------------------------------------------------
# KEPT ON PURPOSE (not ignored):
#   src/            code
#   manifests/      audit results and hashes (define the exact data version)
#   splits/         which image is in which subset (needed to reproduce)
#   results/        small result tables and figures
#   requirements.txt, download scripts
# ---------------------------------------------------------------